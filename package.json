  "license": "MIT",
  "dependencies": {
    "axios": "^1.20.0",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.9"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gl0bal01/discord-ai-assistant.git"
  },
  "bugs": {
    "url": "https://github.com/gl0bal01/discord-ai-assistant/issues"
  },
  "homepage": "https://github.com/gl0bal01/discord-ai-assistant#readme"
