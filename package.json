{
  "name": "discord-ai-assistant",
  "version": "2.0.1",
  "description": "A Discord bot that provides AI chat functionality with multiple models including GPT-6, Claude, Gemini, Grok, and others",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "deploy": "node deploy-commands.js",
    "deploy:global": "GUILD_ID= node deploy-commands.js",
    "check:models": "node scripts/check-models.js"
  },
  "keywords": [
    "discord",
    "bot",
    "ai",
    "chatbot",
    "gpt",
    "claude",
    "gemini",
    "1min.ai"
  ],
